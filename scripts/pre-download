#!/usr/bin/env bash

set -e -o pipefail

. "$(dirname "$0")/tools/common.sh"


PACKAGES_DIR="builder/packages"
CT_VERIFY_DOWNLOAD_DIGEST_ALG="sha512"

#
# Verify the file against a known digest.
#
# CT_DoVerifyDigest <local-file-path> <package-directory>
#
function CT_DoVerifyDigest()
{
	local path="$1"
	local file="${path##*/}"
	local dir="${path%/*}"
	local pkgdir="builder/packages/$2"
	local alg="${CT_VERIFY_DOWNLOAD_DIGEST_ALG}"
	local chksum a f c

	if [ ! -r "${pkgdir}/chksum" ]; then
		echo "[WARN] Not verifying '${file}': digest missing"
		return 0
	fi
	echo "Verifying ${alg} checksum for '${file}'"
	chksum=`"${alg}sum" "${path}"`
	chksum="${chksum%%[[:space:]]*}"
	while read a f c; do
		if [ "${a}" != "${alg}" -o "${f}" != "${file}" ]; then
			continue
		fi
		if [ "${c}" = "${chksum}" ]; then
			# echo "[DEBUG] Correct ${alg} digest for ${file}: ${chksum}"
			return 0
		else
			echo "[ERROR] Bad ${alg} digest for ${file}: ${chksum}, expect ${c}" >&2
			return 1
		fi
	done < "${pkgdir}/chksum"
	echo "[WARN] Downloaded file ${file} reference digest not available"
	return 0
}


#
# Get the latest version of a package.
#
# get_package_version <package-name>
#
function get_package_version() {
	local pkgdir="${PACKAGES_DIR}/$1"
	if [ ! -d "$pkgdir" ]; then return 1; fi

	local version
	version="$({ cd "$pkgdir" && ls -dv -- */ | tail -n 1; } \
		2>/dev/null)"
	version=${version%/}
	if [ -z "$version" ]; then return 2; fi

	printf '%s' "$version"
	return 0
}


function trim() {
	local var="$1"
	# Remove leading whitespace characters
	var="${var#"${var%%[![:space:]]*}"}"
	# Remove trailing whitespace characters
	var="${var%"${var##*[![:space:]]}"}"
	printf '%s' "$var"
}


function install_packages()
{
	local packages="wget"
	sudo apt-get update
	sudo apt-get install -y --no-install-recommends $packages
}


DEST_DIR=$1
if [ -z "$DEST_DIR" ]; then
	DEST_DIR="source-tarballs"
fi

mkdir -p "$DEST_DIR"
if [ ! -d "$DEST_DIR" ]; then
	echo "[ERROR] Directory not found ($DEST_DIR)" >&2
	exit 1
fi

install_packages

config_file="pre-download-config"
script_dir=$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)

if [ ! -f "$script_dir/$config_file" ]; then
	echo "[ERROR] Configuration file not found ($script_dir/$config_file)" >&2
	exit 2
fi

while IFS= read -r line <&3
do
	line=${line%%#*}	# Remove comments
	line=$(trim "$line")

	if [ -n "$line" ]; then
		IFS="|" read -r package_name mirrors <<< "$line"
		package_name=$(trim "$package_name")

		re="^(.+)-([^-]*)(\.tar\..+)$"
		if [[ ! $package_name =~ $re ]]; then
			echo "[ERROR] Invalid package name (${package_name})" >&2
			exit 3
		fi
		package=${BASH_REMATCH[1]}
		version=${BASH_REMATCH[2]}
		ext=${BASH_REMATCH[3]}
		if [[ ! $version =~ ^[0-9.]+$ ]]; then
			version=$(get_package_version "$package")
		fi
		filename="${package}-${version}${ext}"

		success=false
		for mirror in $mirrors; do
			echo "From ${mirror}"
			url="${mirror%/}/${filename}"
			if wget -nv -T 120 --tries=20 -nc --progress=dot:binary -P "$DEST_DIR" "$url" && \
					CT_DoVerifyDigest "${DEST_DIR}/${filename}" "${package}/${version}" ; then
				success=true
				break
			fi
		done
		if ! $success; then
			echo "[ERROR] Unable to download ${filename}" >&2
			exit 4
		fi
	fi
done 3<"$script_dir/$config_file"

exit 0
